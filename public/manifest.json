{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "/?source=pwa",
  "name": "AiKlavuz — Yapay Zeka Dünyası",
  "short_name": "AiKlavuz",
  "description": "Türkiye'nin en kapsamlı yapay zeka platformu. AI Araçları, Prompt Stüdyosu, LLM Fiyat Borsası, AI Kariyer Rehberi ve Akıllı Asistan.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#0d0e12",
  "theme_color": "#0d0e12",
  "orientation": "any",
  "lang": "tr",
  "dir": "ltr",
  "categories": [
    "productivity",
    "utilities",
    "business",
    "education"
  ],
  "prefer_related_applications": false,
  "icons": [
